{
  "Comment": "Wistia daily pipeline: complete ingestion -> isolated Silver -> validated versioned Gold release; SNS on failure",
  "StartAt": "Ingest",
  "States": {
    "Ingest": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": { "FunctionName": "wistia-ingest", "Payload": {} },
      "Retry": [ { "ErrorEquals": ["Lambda.ServiceException", "Lambda.TooManyRequestsException"],
                   "IntervalSeconds": 30, "MaxAttempts": 2, "BackoffRate": 2 } ],
      "Catch": [ { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "NotifyFailure" } ],
      "Next": "SilverClean"
    },
    "SilverClean": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": { "JobName": "wistia-silver-clean", "Arguments": {
        "--run_id.$": "$$.Execution.Name",
        "--extra-py-files": "s3://wistia-data-222238779166/scripts/pipeline_support.py"
      } },
      "Catch": [ { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "NotifyFailure" } ],
      "Next": "GoldBuild"
    },
    "GoldBuild": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": { "JobName": "wistia-gold-build", "Arguments": {
        "--run_id.$": "$$.Execution.Name",
        "--release_started_at.$": "$$.Execution.StartTime",
        "--extra-py-files": "s3://wistia-data-222238779166/scripts/pipeline_support.py"
      } },
      "Catch": [ { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "NotifyFailure" } ],
      "End": true
    },
    "NotifyFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:us-east-1:222238779166:wistia-pipeline-alerts",
        "Subject": "Wistia pipeline FAILED",
        "Message.$": "States.Format('Wistia pipeline failed. Execution: {}. Error: {}', $$.Execution.Id, States.JsonToString($.error))"
      },
      "Next": "PipelineFailed"
    },
    "PipelineFailed": { "Type": "Fail", "Error": "PipelineFailed", "Cause": "A step failed; see the alert email and the execution history." }
  }
}
